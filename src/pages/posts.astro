---
export const prerender = true;

import { getCollection } from "astro:content";
import ArticleCard from "../components/cards/article-card.astro";
import SectionHead from "../components/ui/section-head.astro";
import Layout from "../layouts/main.astro";
import { publishedPosts, sortByDateDesc } from "../lib/posts";

const posts = sortByDateDesc(publishedPosts(await getCollection("post")));
---

<Layout title="Moje piśmiennictwo">
  <main id="main" tabindex="-1">
    <section class="section">
      <div class="container">
        <SectionHead
          title="Moje piśmiennictwo"
          level={1}
          description="Odkryj różnorodny świat moich przemyśleń i doświadczeń. Od tajników programowania po fascynujące zjawiska codziennego życia - moje artykuły to podróż przez różnorodne tematy, które mnie inspirują i intrygują. Zapraszam do lektury i wspólnego odkrywania nowych perspektyw."
        />
        {
          posts.length > 0 && (
            <div class="cards3">
              {posts.map((post, index) => (
                <ArticleCard
                  title={post.data.title}
                  description={post.data.description}
                  category={post.data.category}
                  date={post.data.createdAt}
                  link={`/post/${post.id}`}
                  index={index}
                  badge={post.data.badge}
                />
              ))}
            </div>
          )
        }
      </div>
    </section>
  </main>
</Layout>
