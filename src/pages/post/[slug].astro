---
export const prerender = true;

import { type CollectionEntry, getCollection, render } from "astro:content";
import { contentComponents } from "../../components/blocks/map";
import Layout from "../../layouts/post.astro";
import { relatedPosts } from "../../lib/related";

// Drafty (`isDraft`) nie generują tras — bezpośredni URL draftu → 404.
export async function getStaticPaths() {
	const posts = await getCollection("post", ({ data }) => !data.isDraft);
	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post, related: relatedPosts(post, posts) },
	}));
}

interface Props {
	post: CollectionEntry<"post">;
	related: CollectionEntry<"post">[];
}

const { post, related } = Astro.props;
const { Content, headings } = await render(post);
---

<Layout post={post} headings={headings} related={related}>
  <Content components={contentComponents} />
</Layout>
