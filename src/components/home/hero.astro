---
import Button from "../ui/button.astro";
---

<section class="hero">
  <div class="wrap hero-grid">
    <div>
      <p class="eyebrow">Cześć,</p>
      <h1>jestem <span class="marker">Bartosz.</span></h1>
      <p class="hero-lead">
        Na co dzień buduję oprogramowanie, a hobbystycznie bazgrzę coś na tym
        blogu.
      </p>
      <div class="actions">
        <Button text="Najnowsze artykuły" link="#artykuly" variant="yellow" />
        <Button text="Zobacz projekty" link="/projects" />
        <a
          class="link-tertiary"
          href="https://github.com/bartoszjaniak"
          target="_blank"
          rel="noopener noreferrer"
        >
          ◉ GitHub <span aria-hidden="true">→</span>
          <span class="sr-only">(otwiera w nowej karcie)</span>
        </a>
      </div>
    </div>

    <div class="identity">
      <div class="scribble" aria-hidden="true">
        IDEA<br />BUILD<br />TEST<br />REPEAT
      </div>
      <div class="avatar-card">
        <img
          src="/assets/images/hero.webp"
          alt="Bartosz Janiak"
          width="1254"
          height="1254"
          loading="eager"
          decoding="async"
        />
      </div>
      <div class="note-card">Najpierw sens, potem kod.</div>
    </div>
  </div>
</section>
