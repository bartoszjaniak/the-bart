---
import { getCollection } from "astro:content";
import { publishedPosts, sortByDateDesc } from "../../lib/posts";
import ArticleCard from "../cards/article-card.astro";
import SectionHead from "../ui/section-head.astro";

const posts = sortByDateDesc(publishedPosts(await getCollection("post"))).slice(
	0,
	6,
);
---

<section class="section" id="artykuly">
  <div class="wrap">
    <SectionHead
      title="Najnowsze artykuły"
      link="/posts"
      linkText="Zobacz wszystkie artykuły →"
    />
    {
      posts.length > 0 && (
        <div class="cards3">
          {posts.map((post, index) => (
            <ArticleCard
              title={post.data.title}
              description={post.data.description}
              category={post.data.category}
              date={post.data.createdAt}
              link={`/post/${post.id}`}
              index={index}
              badge={post.data.badge}
            />
          ))}
        </div>
      )
    }
  </div>
</section>
