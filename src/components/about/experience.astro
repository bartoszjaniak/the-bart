---
interface Props {
	logo: string;
	dates: string;
	role: string;
	company: string;
	description: string;
}

const { logo, dates, role, company, description } = Astro.props;
---

<li class="experience">
  <span class="experience-logo">
    <img src={logo} alt={`Logo ${company}`} loading="lazy" decoding="async" />
  </span>
  <div class="experience-body">
    <span class="chip">{dates}</span>
    <h3>{role}</h3>
    <p class="experience-company">{company}</p>
    <p>{description}</p>
  </div>
</li>
