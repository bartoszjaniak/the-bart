---
import ImageFrame from "../ui/image-frame.astro";
import Tag from "../ui/tag.astro";

interface Props {
	name: string;
	description: string;
	image: string;
	imageAlt: string;
	tags?: string[];
	link: string;
}

const { name, description, image, imageAlt, tags = [], link } = Astro.props;

const displayedTags = tags.slice(0, 3);
const remainingTags = tags.length - displayedTags.length;
---

<a class="project-card" href={link}>
  <ImageFrame src={image} alt={imageAlt} ratio="16/9" />
  <h3>{name}</h3>
  <p>{description}</p>
  {
    tags.length > 0 && (
      <div class="tags">
        {displayedTags.map((tag) => (
          <Tag label={tag} />
        ))}
        {remainingTags > 0 && <span class="tag">+{remainingTags}</span>}
      </div>
    )
  }
</a>
