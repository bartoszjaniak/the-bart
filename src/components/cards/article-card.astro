---
import { formatDate } from "../../lib/format";
import { type CardVariant, variantForIndex } from "../../lib/variants";
import Badge from "../ui/badge.astro";
import Chip from "../ui/chip.astro";

interface Props {
	title: string;
	description: string;
	category: string;
	date: Date | string;
	link: string;
	index?: number;
	variant?: CardVariant;
	badge?: { label: string; comment?: string };
}

const {
	title,
	description,
	category,
	date,
	link,
	index = 0,
	variant,
	badge,
} = Astro.props;

// Jedno źródło wariantu: kolor tła glifu i kolor cienia krawędzi karty.
const cardVariant = variant ?? variantForIndex(index);
const formattedDate = formatDate(date);
---

<a class={`article-card ${cardVariant}`} href={link}>
  <div class="card-meta">
    <Chip label={formattedDate} variant="yellow" />
    <Chip label={category} />
    {badge && <Badge label={badge.label} comment={badge.comment} interactive={false} />}
  </div>
  <h3>{title}</h3>
  <p>{description}</p>
  <div class="card-arrow" aria-hidden="true">→</div>
</a>