---
import Brand from "./brand.astro";

const email = import.meta.env.PUBLIC_EMAIL;

const socials = [
	{
		label: "Instagram",
		glyph: "◎",
		url: "https://www.instagram.com/kliszone/",
		external: true,
	},
	{
		label: "GitHub",
		glyph: "◉",
		url: "https://github.com/bartoszjaniak",
		external: true,
	},
	{
		label: "LinkedIn",
		glyph: "in",
		url: "https://www.linkedin.com/in/bartosz-janiak-super-dev",
		external: true,
	},
];

// Mailto tylko gdy `PUBLIC_EMAIL` jest ustawione; nie otwiera nowej karty,
// więc nie dziedziczy komunikatu „(otwiera w nowej karcie)".
if (email) {
	socials.push({
		label: "Email",
		glyph: "✉",
		url: `mailto:${email}`,
		external: false,
	});
}
---

<footer class="footer">
  <div class="wrap footer-inner">
    <Brand />

    <div class="footer-social">
      {
        socials.map((social) => (
          <a
            href={social.url}
            target={social.external ? "_blank" : undefined}
            rel={social.external ? "noopener noreferrer" : undefined}
            aria-label={
              social.external
                ? `${social.label} (otwiera w nowej karcie)`
                : undefined
            }
          >
            <span aria-hidden="true">{social.glyph}</span>
            {social.label}
            {social.external && <span aria-hidden="true">↗</span>}
          </a>
        ))
      }
    </div>

    <div class="footer-copy">
      © {new Date().getFullYear()} Bartosz Janiak<br />
      Tworzę lepszy internet. <span class="heart" aria-hidden="true">♥</span>
    </div>
  </div>
</footer>
