---
import type { CollectionEntry } from "astro:content";
import Button from "../components/ui/button.astro";
import ImageFrame from "../components/ui/image-frame.astro";
import Tag from "../components/ui/tag.astro";
import Layout from "./main.astro";

interface Props {
	project: CollectionEntry<"project">;
}

const { project } = Astro.props;
const { name, description, image, imageAlt, projectUrl, tags } = project.data;
---

<Layout title={name}>
  <meta slot="head" name="description" content={description} />

  <main id="main" tabindex="-1" class="article-shell">
    <div class="wrap">
      <nav class="breadcrumb" aria-label="Ścieżka nawigacji">
        <a href="/projects">Projekty</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{name}</span>
      </nav>

      <section class="article-main-head">
        <h1 class="article-title">{name}</h1>
        {
          tags.length > 0 && (
            <div class="tags">
              {tags.map((tag) => (
                <Tag label={tag} />
              ))}
            </div>
          )
        }
      </section>

      <div class="project-visual">
        <ImageFrame src={image} alt={imageAlt} ratio="16/9" />
      </div>

      <article class="prose project-prose">
        <slot />
      </article>

      {
        projectUrl && (
          <div class="actions project-cta">
            <Button
              text="Zobacz projekt ↗"
              link={projectUrl}
              variant="yellow"
              external
            />
          </div>
        )
      }

      <div class="actions article-back">
        <Button text="← Wróć do projektów" link="/projects" />
      </div>
    </div>
  </main>
</Layout>
