---
import "../assets/css/main.css";
import { Font } from "astro:assets";
import Footer from "../components/layout/footer.astro";
import Header from "../components/layout/header.astro";
import SkipLink from "../components/layout/skip-link.astro";

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-WYPM73WT1W"></script>
    <script>
    // @ts-ignore
    window.dataLayer = window.dataLayer || [];
    // @ts-ignore
    function gtag(){dataLayer.push(arguments);}
    // @ts-ignore
    gtag('js', new Date());
    // @ts-ignore
    gtag('config', 'G-WYPM73WT1W');
    </script>

    <Font cssVariable="--font-anton" preload />

    <link rel="icon" type="image/svg+xml" href="/assets/images/the-bart.svg" />
    <slot name="head" />
    <Fragment set:html={import.meta.env.HEADER_INJECT} />

  </head>
  <body class="antialiased">
    <SkipLink />
    <Header />
    <slot />
    <Footer />
    <Fragment set:html={import.meta.env.FOOTER_INJECT} />
    <script>
      import "../assets/js/main.js";
    </script>
  </body>
</html>
