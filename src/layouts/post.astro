---
import type { CollectionEntry } from "astro:content";
import type { MarkdownHeading } from "astro";
import AuthorBar from "../components/content/author-bar.astro";
import RelatedPosts from "../components/content/related-posts.astro";
import Sidebox from "../components/content/sidebox.astro";
import Toc from "../components/content/toc.astro";
import TopicTags from "../components/content/topic-tags.astro";
import Button from "../components/ui/button.astro";
import Chip from "../components/ui/chip.astro";
import ImageFrame from "../components/ui/image-frame.astro";
import { formatDate } from "../lib/format";
import { absoluteImageUrl } from "../lib/images";
import { readingTime } from "../lib/reading-time";
import Layout from "./main.astro";

interface Props {
	post: CollectionEntry<"post">;
	headings: MarkdownHeading[];
	related: CollectionEntry<"post">[];
}

const { post, headings, related } = Astro.props;
const {
	title,
	description,
	image,
	imageAlt,
	category,
	tags,
	createdAt,
	stickyNote,
} = post.data;

const dateLabel = formatDate(createdAt);
const minutes = readingTime(post.body ?? "");

// OG/Twitter: absolutne URL-e; `og:url` z pathname (bez query stringa).
const ogImage = absoluteImageUrl(image, Astro.site);
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
---

<Layout title={title}>
  <meta slot="head" name="description" content={description} />
  <meta slot="head" property="og:title" content={title} />
  <meta slot="head" property="og:description" content={description} />
  <meta slot="head" property="og:image" content={ogImage} />
  <meta slot="head" property="og:url" content={canonical.href} />
  <meta slot="head" property="og:type" content="article" />
  <meta slot="head" name="twitter:card" content="summary_large_image" />
  <meta slot="head" name="twitter:title" content={title} />
  <meta slot="head" name="twitter:description" content={description} />
  <meta slot="head" name="twitter:image" content={ogImage} />

  <main id="main" tabindex="-1" class="article-shell">
    <div class="container">
      <nav class="breadcrumb" aria-label="Ścieżka nawigacji">
        <a href="/posts">Artykuły</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{title}</span>
      </nav>

      <section class="article-hero">
        <div class="article-main-head">
          <div class="card-meta">
            <Chip label={dateLabel} variant="yellow" />
            <Chip label={category} />
            <Chip label={`${minutes} min czytania`} />
          </div>
          <h1 class="article-title">{title}</h1>
          <p class="article-dek">{description}</p>
        </div>
        <div class="article-visual">
          <ImageFrame src={image} alt={imageAlt} ratio="auto" />
          {stickyNote && <div class="sticky-note">{stickyNote}</div>}
        </div>
      </section>

      <AuthorBar url={canonical.href} />

      <div class="article-layout">
        <Toc headings={headings} variant="mobile" />
        <article class="prose">
          <slot />
        </article>
        <aside class="sidebar">
          <Toc headings={headings} />
          <Sidebox title="Powiązane tematy">
            <TopicTags tags={tags} category={category} />
          </Sidebox>
        </aside>
      </div>

      <RelatedPosts posts={related} />

      <div class="actions article-back">
        <Button text="← Wróć do artykułów" link="/posts" />
      </div>
    </div>
  </main>
</Layout>
